# ============================================================
# KnowledgeFlow 运行配置 —— 复制为 .env 后按需修改(.env 已被 gitignore)
# 不配置 LLM_API_KEY 也能跑:自动进入离线 Mock 演示模式
# ============================================================

APP_ENV=dev
LOG_LEVEL=INFO

# ---------- LLM(OpenAI 兼容网关)----------
LLM_BACKEND=auto
# 任意 OpenAI 兼容网关均可:官方 / 中转 / 自建 vLLM 等
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_MODEL_PRO=deepseek/deepseek-v4.1-flash
LLM_PROXY=
LLM_TIMEOUT=90
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.3

# ---------- Embedding(本地模型,首次运行自动下载 ~100MB)----------
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HASH_DIM=512
HF_ENDPOINT=https://hf-mirror.com

# ---------- 重排(Cross-Encoder)----------
RERANK_ENABLED=false
RERANK_BACKEND=auto
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_N=10

# ---------- 向量库:auto(装了 chromadb 用它,否则 numpy 精确检索)----------
VECTOR_BACKEND=auto
COLLECTION_NAME=kf_docs

# ---------- 检索参数 ----------
TOP_K=5
CANDIDATE_K=20
RRF_K=60
REWRITE_ENABLED=true
HYDE_ENABLED=false

# ---------- Agent / NLU ----------
MAX_AGENT_ROUNDS=3
TOOL_TIMEOUT_S=8
INTENT_ENABLED=true
INTENT_BACKEND=auto
INTENT_MODEL_DIR=data/intent_model
INTENT_THRESHOLD=0.6
SELF_CHECK_ENABLED=true
AGENTIC_MAX_ROUNDS=3

# ---------- 记忆 ----------
MEMORY_WINDOW_TURNS=5
SUMMARY_THRESHOLD_TOKENS=2000

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
